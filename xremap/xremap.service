[Unit]
Description=xremap
# On KDE, xremap loads its KWin script over D-Bus at startup, so it needs the
# session up first. Harmless on GNOME.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10
ExecStart=xremap --watch=device,config %h/.config/xremap/config.yml

[Install]
# Must match PartOf above. With WantedBy=default.target the unit was stopped
# with the graphical session but never started again, since default.target is
# only reached once per user-manager lifetime: any gnome-shell restart left
# xremap dead until the next reboot.
WantedBy=graphical-session.target
